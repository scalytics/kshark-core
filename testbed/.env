# =============================================================================
# kshark Integration Testbed - Environment Variables
# =============================================================================

# --- Confluent Platform ---
CP_VERSION=7.7.1
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# --- MongoDB ---
MONGO_VERSION=7.0
MONGO_ROOT_USER=testuser
MONGO_ROOT_PASS=testpass
MONGO_DATABASE=testdb
MONGO_COLLECTION=events

# --- PostgreSQL ---
POSTGRES_VERSION=16
POSTGRES_USER=pguser
POSTGRES_PASSWORD=pgpass
POSTGRES_DB=testdb

# --- DB2 ---
DB2_VERSION=11.5.9.0
DB2_USER=db2inst1
DB2_PASSWORD=db2pass
DB2_DATABASE=TESTDB

# --- kshark ---
KSHARK_IMAGE=kshark:latest

# --- Timeouts ---
# Maximum time (seconds) to wait for each service to become healthy
HEALTHCHECK_TIMEOUT=300
